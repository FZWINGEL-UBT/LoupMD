# The build image of the LoupMD wheel (PLAN.md S2-T02; tools/release/build_wheel.sh builds and uses it).
#
# CUDA 13.3 on Rocky Linux 8: the compiler the engine was developed and measured with, on the glibc (2.28) that
# makes the library a manylinux_2_28 one. gcc-toolset-13 is the host compiler, as on the development machine; its
# additions to libstdc++ are linked statically, so the library asks for no more than Rocky 8's own libstdc++.
# The library runs on the CUDA runtime the package pins (cuda-toolkit 13.0.3, as torch's): every CUDA symbol it
# imports is in those libraries (PLAN.md D58).
FROM nvidia/cuda:13.3.1-devel-rockylinux8

RUN dnf install -y gcc-toolset-13-gcc-c++ make binutils python3.11 python3.11-pip \
    && dnf clean all && rm -rf /var/cache/dnf

# What the wheel is built and checked with (pyproject.toml asks for setuptools>=77); twine for make_release.sh.
RUN python3.11 -m pip install --no-cache-dir "setuptools>=77,<81" "wheel>=0.45,<0.46" "build>=1.2,<1.3" \
    "auditwheel>=6.2,<7" "twine>=6.1,<7"
