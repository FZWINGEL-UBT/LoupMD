  "diagnostic_source": "\"\"\"Observe native Fukui cancellation without changing model outputs; reserved execution only.\"\"\"\nimport argparse\nimport gc\nimport json\nfrom pathlib import Path\n\nimport numpy as np\nimport torch\nfrom ase import Atoms\nfrom ase.io import read as ase_read\nfrom mace.calculators import MACECalculator\n\nap = argparse.ArgumentParser()\nap.add_argument(\"model\", choices=[\"S\", \"L\"])\nap.add_argument(\"--ref-device\", required=True, choices=[\"cuda\", \"cpu\"])\na = ap.parse_args()\nif a.model == \"L\" and a.ref_device != \"cpu\":\n    ap.error(\"POLAR-L references must stay on CPU\")\ntorch.backends.cuda.matmul.allow_tf32 = False\ntorch.set_float32_matmul_precision(\"highest\")\ntorch.use_deterministic_algorithms(True)\nroot = Path(\"/mnt/d/Margraf/LoupMD/.tmp_o\")\nout = root / f\"polar_fukui_condition_{a.model}\"\nout.mkdir(exist_ok=False)\ncases = [\"NaCl_c0\", \"Na2O_c0\", \"Nb2O5_c0\", \"Ta2O5_c0\"] if a.model == \"S\" else [\"NaCl_c0\", \"Na2O_c2\", \"Nb2O5_c0\"]\nconfigs = {}\nreference_energy = {}\nfor name in cases:\n    if name in (\"NaCl_c0\", \"Na2O_c0\"):\n        with np.load(root/f\"polar_pure_S_0/{name}_reference.npz\") as z:\n            ref = {k:z[k].copy() for k in z.files}\n        cif = Path(f\"/mnt/d/Margraf/ResearchModule/Structures/Benchmark/R2SCAN/{name.rsplit('_c',1)[0]}.cif\")\n        base = ase_read(cif)\n        at = base.repeat([max(1, int(np.ceil(13/h))) for h in base.cell.cellpar()[:3]])\n        at.set_cell(ref[\"cell\"], scale_atoms=False)\n        at.positions[:] = ref[\"positions\"]\n        if a.model == \"S\":\n            reference_energy[name] = float(ref[\"e64\"])\n    else:\n        owner = \"L\" if name == \"Na2O_c2\" else \"S\"\n        with np.load(root/f\"local_polar_replay_{owner}/{name}_input.npz\") as z:\n            at = Atoms(numbers=z[\"numbers\"], positions=z[\"positions\"], cell=z[\"cell\"], pbc=True)\n        with np.load(root/f\"a100_failure_replay/{a.model}_{name}/{name}_reference.npz\") as z:\n            assert np.array_equal(at.positions, z[\"positions\"])\n            assert np.array_equal(at.cell.array, z[\"cell\"])\n            reference_energy[name] = float(z[\"e64\"])\n    configs[name] = at\n\nrecords = []\nfor dtype in (\"float64\", \"float32\"):\n    calc = MACECalculator(model_paths=f\"/home/fzwin/models/MACE-POLAR-1-{a.model}.model\", device=a.ref_device, default_dtype=dtype)\n    model = calc.models[0]\n    captured = []\n\n    def observe(stage):\n        def hook(module, inputs, output):\n            raw = output[:, -2:].detach().double()\n            norm = raw.sum(0)\n            l1 = raw.abs().sum(0)\n            condition = l1 / norm.abs()\n            captured.append({\"stage\": stage, \"sum\": norm.cpu().tolist(), \"sum_abs\": l1.cpu().tolist(), \"condition\": [float(x) if np.isfinite(x) else None for x in condition.cpu().tolist()]})\n        return hook\n\n    hooks = [model.fukui_source_map.register_forward_hook(observe(\"initial\"))]\n    hooks += [m.register_forward_hook(observe(f\"recursion_{i}\")) for i,m in enumerate(model.field_dependent_charges_maps)]\n    for name, at in configs.items():\n        captured.clear()\n        data = calc._atoms_to_batch(at).to_dict()\n        with torch.no_grad():\n            energy = float(model(data, compute_force=False, compute_stress=False)[\"energy\"].item())\n        assert len(captured) == 1 + model.num_recursion_steps\n        row = {\"model\": a.model, \"config\": name, \"dtype\": dtype, \"energy\": energy, \"energy_minus_saved64\": None if name not in reference_energy else energy-reference_energy[name], \"stages\": list(captured)}\n        records.append(row)\n        print(json.dumps(row, allow_nan=False), flush=True)\n        if a.model == \"L\" and name == \"Nb2O5_c0\" and dtype == \"float64\":\n            from polar_reference import energy_stress\n            native_energy, native_stress = energy_stress(calc, at)\n            np.savez(out / \"Nb2O5_c0_native64.npz\", e=native_energy, s=native_stress)\n        del data\n    for hook in hooks:\n        hook.remove()\n    del model, calc\n    gc.collect(); torch.cuda.empty_cache()\n(out / \"rows.json\").write_text(json.dumps(records, indent=2, allow_nan=False)+\"\\n\")\n"
